package app

import (
	"context"
	"fmt"
	"log/slog"
	"net"
	"net/http"
	"time"

	{{ if .modules.postgres.enabled }}"github.com/jackc/pgx/v5/pgxpool"
	"{{ .modulePath }}/internal/repository/postgres"
	useruc "{{ .modulePath }}/internal/usecase/user"
	{{ end }}"{{ .modulePath }}/internal/config"
	httpdelivery "{{ .modulePath }}/internal/delivery/http"
)

type App struct {
	cfg    config.Config
	logger *slog.Logger
	srv    *http.Server
	{{ if .modules.postgres.enabled }}pool   *pgxpool.Pool
	{{ end }}
}

func New(ctx context.Context, cfg config.Config) (*App, error) {
	{{ if .modules.postgres.enabled }}pool, err := postgres.Connect(ctx, cfg.DatabaseURL)
	if err != nil {
		return nil, err
	}
	if err := postgres.Migrate(ctx, pool); err != nil {
		pool.Close()
		return nil, err
	}
	{{ end }}logger := slog.Default()
	{{ if .modules.postgres.enabled }}userRepo := postgres.UserRepository{Pool: pool}
	h := httpdelivery.UserHandlers{
		Create: useruc.CreateUser{Repo: userRepo},
		Get:    useruc.GetUser{Repo: userRepo},
	}
	handler := httpdelivery.NewRouter(httpdelivery.RouterDeps{
		Logger:         logger,
		RequestTimeout: cfg.RequestTimeout,
		DB:             pool,
		UserHandlers:   h,
	})
	{{ else }}handler := httpdelivery.NewRouter(httpdelivery.RouterDeps{
		Logger:         logger,
		RequestTimeout: cfg.RequestTimeout,
	})
	{{ end }}srv := &http.Server{
		Addr:              cfg.HTTPAddr,
		Handler:           handler,
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       15 * time.Second,
		WriteTimeout:      30 * time.Second,
		IdleTimeout:       60 * time.Second,
	}
	return &App{
		cfg:    cfg,
		logger: logger,
		srv:    srv,
		{{ if .modules.postgres.enabled }}pool:   pool,
		{{ end }}
	}, nil
}

func (a *App) Run(ctx context.Context, shutdownCtx context.Context) error {
	a.srv.BaseContext = func(_ net.Listener) context.Context {
		return ctx
	}
	errCh := make(chan error, 1)
	go func() {
		a.logger.Info("http_listen", slog.String("addr", a.srv.Addr))
		if err := a.srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			errCh <- err
			return
		}
		errCh <- nil
	}()
	select {
	case <-ctx.Done():
		a.logger.Info("shutdown_start")
		if err := a.srv.Shutdown(shutdownCtx); err != nil {
			_ = a.srv.Close()
			{{ if .modules.postgres.enabled }}a.pool.Close()
			{{ end }}return fmt.Errorf("shutdown: %w", err)
		}
		{{ if .modules.postgres.enabled }}a.pool.Close()
		{{ end }}a.logger.Info("shutdown_complete")
		return nil
	case err := <-errCh:
		{{ if .modules.postgres.enabled }}a.pool.Close()
		{{ end }}return err
	}
}
