package config

import (
	{{ if .modules.postgres.enabled }}"fmt"
	{{ end }}"os"
	"strconv"
	"time"
)

type Config struct {
	HTTPAddr        string
	{{ if .modules.postgres.enabled }}DatabaseURL     string
	{{ end }}ShutdownTimeout time.Duration
	LogLevel        string
	RequestTimeout  time.Duration
}

func Load() (Config, error) {
	cfg := Config{
		HTTPAddr:        getenv("HTTP_ADDR", ":{{ .apiPort }}"),
		{{ if .modules.postgres.enabled }}DatabaseURL:     os.Getenv("DATABASE_URL"),
		{{ end }}LogLevel:        getenv("LOG_LEVEL", "{{ .logLevel }}"),
		RequestTimeout:  durationEnv("REQUEST_TIMEOUT_MS", {{ .requestTimeoutMs }}),
		ShutdownTimeout: durationEnv("SHUTDOWN_TIMEOUT_MS", {{ .shutdownTimeoutMs }}),
	}
	{{ if .modules.postgres.enabled }}if cfg.DatabaseURL == "" {
		return Config{}, fmt.Errorf("DATABASE_URL is required")
	}
	{{ end }}return cfg, nil
}

func getenv(key, fallback string) string {
	v := os.Getenv(key)
	if v == "" {
		return fallback
	}
	return v
}

func durationEnv(key string, defaultMS int) time.Duration {
	v := os.Getenv(key)
	if v == "" {
		return time.Duration(defaultMS) * time.Millisecond
	}
	ms, err := strconv.Atoi(v)
	if err != nil || ms <= 0 {
		return time.Duration(defaultMS) * time.Millisecond
	}
	return time.Duration(ms) * time.Millisecond
}
